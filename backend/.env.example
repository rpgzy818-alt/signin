# 签到会 环境配置示例
# 用法：复制成 .env，至少把 ADMIN_TOKEN 改掉，然后 `docker compose up -d`
# 只有标了【必填】的需要动，其余留空即为默认行为。

# ============================================================
# 数据库
# ============================================================
# DB_ENV：环境标识，会写进每一行数据的 env 列，并校验库文件名里含同样字样（防串库）。
# 一般只有一套环境，保持 prod 即可；另起测试环境时改成 staging，
# 同时把 DB_PATH 的文件名也改成带 staging 的，这样两套库不会互相覆盖。
DB_ENV=prod

# SQLite 文件路径。留空 = 项目根 data/signin_prod.db。
# Docker 部署时由 compose 注入 /data/signin_prod.db，落在挂载卷上。
DB_PATH=

# 想用 PostgreSQL 就填下面两行，并把 DB_BACKEND 改成 postgres。
# 库名里必须含 DB_ENV 的值（如 signin_prod）。
DB_BACKEND=sqlite
PG_DSN=

# ============================================================
# 凭据【必填】
# ============================================================
# ADMIN_TOKEN 有两个身份：
#   1) 启动校验的强口令（少于 12 位会拒绝启动）
#   2) 首次启动时创建的管理员账号 admin 的初始密码
# 所以第一次启动前就要定好它，之后用 admin + 这个口令登录后台。
# 后台入口：http://你的域名/admin/
ADMIN_TOKEN=change-me-please-12chars

# 工作人员口令，逗号分隔。工作人员凭这里的口令进核销页，不需要账号。
# 少于 12 位会拒绝启动（可用 ALLOW_WEAK_TOKEN=1 临时放行，仅限本地调试）。
STAFF_TOKENS=change-me-staff-1

# ============================================================
# 签到时段
# ============================================================
# 只有「开关打开 + 当前时间在窗口内」才允许签到。
# 后台「时段设置」里改了之后以数据库为准，这里的值只作为初始默认。
# 留空 = 启动当天 09:00–18:00。
CHECKIN_SWITCH=false
WINDOW_START=
WINDOW_END=

# ============================================================
# 站点
# ============================================================
# 允许跨域访问的来源。同域部署（前端与接口同一个域名）保持 * 即可；
# 前后端分开部署时填前端的域名，如 https://signin.example.com
CORS_ORIGINS=*

# 静态资源根目录：上传的附件、物料封面等写到这里。
# Docker 部署由 compose 注入 /data，与数据库同一个卷。
WEB_ROOT=/data

# 前端目录。填了就让本服务一并托管页面（单容器跑通）；
# 留空则只提供接口，页面交给 Nginx 或对象存储。
FRONTEND_DIR=

# ============================================================
# 可选能力
# ============================================================
# 外链按钮（报名成功后跳转到问卷、公众号等）的域名白名单，逗号分隔。
# 留空只放行微信相关域名；要用自己的外链就填进来。
CTA_URL_DOMAINS=

# 紧急放行：允许弱令牌启动。**只在本地调试时用**，线上不要开。
ALLOW_WEAK_TOKEN=false
